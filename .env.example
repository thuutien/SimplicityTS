# Copy this file to .env and fill in your details. Restart the server after changing it.

# Address people use to reach the app. Used for links in emails.
# Change this when you move to the local server, e.g. http://192.168.1.50:5000
APP_URL=http://localhost:5000
PORT=5000

# First admin account, created only when the database is empty.
# If ADMIN_PASSWORD is left empty, a random password is printed in the console on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# How long "Keep me logged in" lasts, counted from the last visit
REMEMBER_DAYS=90

# Name shown as the email sender
APP_NAME=Retail King Helpdesk

# Only emails at this domain can sign up
ALLOWED_SIGNUP_DOMAIN=retailking.com

# Email sending (SMTP). Leave SMTP_HOST empty to print emails to the console instead.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.helpdesk.mailbox@gmail.com
SMTP_PASS=
# Optional: defaults to SMTP_USER
MAIL_FROM=
